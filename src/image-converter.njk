---
layout: layouts/base.njk
contentKey: image-converter
ldType: tool
contentType: tool
permalink: /image-converter/
sitemap: true
mainClass: wrap
pageScript: tools/converter.js
---
{% set c = toolpages[contentKey] %}
{% set t = toolList | toolBySlug(contentKey) %}
{% from "partials/icons.njk" import icon %}
<div class="breadcrumb"><a href="/">Toolkit</a><span aria-hidden="true">/</span><span>{{ c.breadcrumb }}</span></div>

<section class="tool-hero">
  <div class="hero-row">
    <span class="icon-tile icon-hero {{ t.tone }}" aria-hidden="true">{{ icon(t.icon) }}</span>
    <div class="hero-copy">
      <span class="kicker">{{ c.kicker }}</span>
      <h1>{{ c.h1 }}</h1>
      <p>{{ c.lede }}</p>
    </div>
  </div>
</section>

<section class="workspace">
  <div class="pane">
    <div class="pane-head"><h2>Images</h2><span class="hint">up to 30 files</span></div>

    <div class="dropzone" id="dropzone" tabindex="0" role="button">
      <div class="dz-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13"/><path d="m13 4 4 4-4 4"/><path d="M20 16H7"/><path d="m11 12-4 4 4 4"/></svg>
      </div>
      <b>Drop images here or click to choose</b>
      <span class="mini">JPG, PNG or WebP · converted on your device</span>
    </div>
    <input class="visually-hidden" id="fileInput" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-label="Choose an image">

    <div class="row" style="margin-top:14px">
      <div class="field">
        <span class="field-label">Convert to</span>
        <div class="seg" id="formatSeg">
          <button type="button" data-format="image/jpeg" class="on" aria-pressed="true">JPG</button>
          <button type="button" data-format="image/webp" aria-pressed="false">WebP</button>
          <button type="button" data-format="image/png" aria-pressed="false">PNG</button>
        </div>
        <input type="hidden" id="outFormat" value="image/jpeg">
      </div>
      <div class="field" id="qualityField">
        <label for="quality">Quality</label>
        <div class="range-row">
          <input type="range" id="quality" min="0.4" max="0.95" step="0.01" value="0.86">
          <output id="qualityValue">0.86</output>
        </div>
      </div>
    </div>

    <div class="field">
      <label for="bgColor">Background for JPG</label>
      <input type="color" id="bgColor" value="#ffffff">
    </div>

    <div class="note"><span class="pin">i</span><span>Changing the format re-encodes every listed image with the current settings. JPG has no transparency, so transparent pixels take the background colour.</span></div>
  </div>

  <div class="pane">
    <div class="pane-head"><h2>Results</h2><span class="hint" id="multiNotice" hidden>Allow multiple downloads if your browser asks.</span></div>

    <div class="summary-bar" id="summary" hidden>
      <div class="facts">
        <span><b id="sumCount">0</b> files</span>
        <span>Before <b id="sumBefore">—</b></span>
        <span>After <b id="sumAfter">—</b></span>
        <span>Saved <b id="sumSaved">—</b></span>
        <span id="sumFailed" class="failed" hidden><b id="sumFailedNum">0</b> failed</span>
      </div>
      <div class="split-actions">
        <button class="btn btn-sm btn-primary" id="downloadAll" type="button" disabled>Download all</button>
        <button class="btn btn-sm btn-ghost" id="clearAll" type="button" disabled>Clear</button>
      </div>
    </div>

    <div class="empty-muted" id="listEmpty">No images yet. Add files to see the converted size for each one.</div>
    <div class="list-scroll" id="fileList"></div>

    <div class="note"><span class="pin">i</span><span>An image that is already in the chosen format is still re-encoded, which can occasionally make a small file larger - the real result is shown.</span></div>
  </div>
</section>

{% include "partials/support.njk" %}

<section class="below">
  <aside class="aside">
    <h2>Next tools</h2>
    <div class="related">
      {% for r in c.related %}{% set rt = toolList | toolBySlug(r.slug) %}
      <a href="{{ rt.url }}"><span class="icon-tile {{ r.tone }}" aria-hidden="true">{{ icon(rt.icon) }}</span><span><b>{{ rt.relatedName or rt.footerName or rt.name }}</b><small>{{ r.note }}</small></span></a>
      {% endfor %}
    </div>
  </aside>
</section>
