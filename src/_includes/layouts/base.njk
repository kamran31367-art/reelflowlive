{% if contentType == "home" %}{% set c = home %}
{% elif contentType == "tool" %}{% set c = toolpages[contentKey] %}
{% elif contentType == "system" %}{% set c = system[contentKey] %}{% endif %}
{% set t = toolList | toolBySlug(contentKey) %}
{% set badgeText = ldType == "home" and site.badges.home or site.badges.tools %}
{% if ldType == "category" %}
{% set pageTitle = category.name + " Tools - ReelFlow Toolkit" %}
{% set pageDescription = category.description %}
{% set pageOgTitle = pageTitle %}
{% set pageOgDescription = pageDescription %}
{% else %}
{% set pageTitle = (c and c.metaTitle) or metaTitle %}
{% set pageDescription = (c and c.description) or description %}
{% set pageOgTitle = (c and c.ogTitle) or ogTitle or pageTitle %}
{% set pageOgDescription = (c and c.ogDescription) or ogDescription or pageDescription %}
{% endif %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{% if not noindex %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
<meta name="theme-color" content="#f6f8fb">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="ReelFlow Toolkit blog" href="/blog/feed.xml">
{% if not noindex %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="ReelFlow Toolkit">
<meta property="og:title" content="{{ pageOgTitle }}">
<meta property="og:description" content="{{ pageOgDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
{% else %}
<meta name="robots" content="noindex">
{% endif %}
<link rel="stylesheet" href="/assets/css/site.css">
{% if ldType == "home" %}
<script type="application/ld+json">{{ toolList | homeLd(site) | jsonld | safe }}</script>
{% elif ldType == "tool" %}
<script type="application/ld+json">{{ c | toolLd(t, site, page.url) | jsonld | safe }}</script>
{% elif ldType == "category" %}
<script type="application/ld+json">{{ category | categoryLd(site, page.url) | jsonld | safe }}</script>
{% elif ldType == "blog" %}
<script type="application/ld+json">{{ collections.posts | blogLd(site) | jsonld | safe }}</script>
{% elif ldType == "post" %}
<script type="application/ld+json">{{ title | postLd(description, date, updated, cover, categories, site, page.url) | jsonld | safe }}</script>
{% if faq %}<script type="application/ld+json">{{ faq | faqLd | jsonld | safe }}</script>{% endif %}
{% endif %}
</head>
<body>
{% include "partials/header.njk" %}

<main{% if mainClass %} class="{{ mainClass }}"{% endif %}>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/consent.njk" %}

<script src="/assets/js/utils.js"></script>
<script src="/assets/js/app.js"></script>
{% if pageScript %}<script src="/assets/js/{{ pageScript }}"></script>{% endif %}
<script>window.CT_ADS = {{ ads | dump | safe }};</script>
<script src="/assets/js/ads.js"></script>
</body>
</html>
