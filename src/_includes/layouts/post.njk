---
layout: layouts/base.njk
---
{% set toc = content | toc %}
{% set related = relatedTools[page.fileSlug] %}
{% set tool = (toolList | toolBySlug(page.fileSlug)) or (related and related.length and { url: related[0].href, footerName: related[0].name }) %}
<article class="post post-wide">
  <div class="breadcrumb">
    <a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>{{ title }}</span>
  </div>

  <header class="tool-hero post-hero">
    <span class="kicker">{% if categories and categories.length %}{{ categories | join(" · ") }}{% else %}Guide{% endif %}</span>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
    <p class="post-meta">Published {{ date | longDate }}{% if updated %} · Updated {{ updated | longDate }}{% endif %} · By {{ author or "ReelFlow Live Team" }}</p>
  </header>

  {% if cover %}
  <figure class="post-hero-figure">
    <img class="post-cover-hero" src="{{ cover | assetUrl }}" alt="{{ coverAlt or title }}" width="1200" height="630" loading="eager">
    {% if coverCaption %}<figcaption>{{ coverCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <div class="post-layout">
    <div class="prose post-content">{{ content | safe }}</div>
    {% if toc.length %}
    <aside class="post-side">
      <nav class="side-card side-toc" aria-label="On this page">
        <b>On this page</b>
        <ol>
          {% for item in toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>{% endfor %}
        </ol>
      </nav>
      {% if tool %}<a class="btn btn-primary btn-sm side-cta" href="{{ tool.url }}">Open {{ tool.footerName or tool.name }}</a>{% endif %}
    </aside>
    {% endif %}
  </div>

  {% if takeaways and takeaways.length %}
  <section class="takeaways" aria-labelledby="takeaways-title">
    <h2 id="takeaways-title">Key takeaways</h2>
    <ul>
      {% for line in takeaways %}<li>{{ line }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if related and related.length %}
  <section class="rel-tools" id="related-tools" aria-labelledby="related-title">
    <h2 id="related-title">10 tools for this job</h2>
    <p class="rel-lede">Start with the free browser tool from ReelFlow Live, then keep these nine nearby for everything around the job.</p>
    <ol class="rel-list">
      {% for item in related %}
      <li class="rel-item{% if loop.first %} rel-top{% endif %}">
        <span class="rel-num" aria-hidden="true">{{ loop.index }}</span>
        <div class="rel-body">
          <a href="{{ item.href }}"{% if item.external %} rel="nofollow noopener" target="_blank"{% endif %}>{{ item.name }}</a>
          {% if loop.first %}<span class="rel-badge">ReelFlow Live tool</span>{% endif %}
          {% if item.note %}<small>{{ item.note }}</small>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if faq and faq.length %}
  <section class="post-faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    {% for item in faq %}
    <details{% if loop.first %} open{% endif %}>
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  <aside class="post-cta">
    <div>
      <b>Put this guide to work</b>
      <span>Every tool runs on your device. No upload, no signup.</span>
    </div>
    <a class="btn btn-primary btn-sm" href="{% if tool %}{{ tool.url }}{% else %}/#tools{% endif %}">{% if tool %}Open the tool{% else %}Browse the tools{% endif %}</a>
  </aside>

  {% if site.support %}
  <p class="post-support">Guides like this stay free through a sponsor. If one saved you time, <a href="{{ site.support.href }}" target="_blank" rel="sponsored noopener noreferrer">{{ site.support.label }}</a>.</p>
  {% endif %}

  <p class="post-back"><a href="/blog/">&larr; All articles</a></p>
</article>
