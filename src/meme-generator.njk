---
layout: layouts/base.njk
contentKey: meme-generator
ldType: tool
contentType: tool
permalink: /meme-generator/
sitemap: true
mainClass: wrap
pageScript: tools/meme.js
---
{% set c = toolpages[contentKey] %}
{% set t = toolList | toolBySlug(contentKey) %}
{% from "partials/icons.njk" import icon %}
<div class="breadcrumb"><a href="/">Toolkit</a><span aria-hidden="true">/</span><span>{{ c.breadcrumb }}</span></div>

<section class="tool-hero">
  <div class="hero-row">
    <span class="icon-tile icon-hero {{ t.tone }}" aria-hidden="true">{{ icon(t.icon) }}</span>
    <div class="hero-copy">
      <span class="kicker">{{ c.kicker }}</span>
      <h1>{{ c.h1 }}</h1>
      <p>{{ c.lede }}</p>
    </div>
  </div>
</section>

<section class="workspace">
  <div class="pane">
    <div class="pane-head"><h2>Meme</h2><span class="hint">one image</span></div>

    <div class="dropzone" id="memeDropzone" tabindex="0" role="button" aria-label="Choose an image for the meme">
      <div class="dz-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10"/><path d="M7 15.5h10"/></svg>
      </div>
      <b>Drop an image here or click to choose</b>
      <span class="mini">JPG, PNG or WebP · nothing is uploaded</span>
    </div>
    <input class="visually-hidden" id="memeFile" type="file" accept="image/jpeg,image/png,image/webp">

    <div class="file-info" id="memeInfo" hidden>
      <div class="meta-row"><span>File</span><b id="memeName">—</b></div>
      <div class="meta-row"><span>Dimensions</span><b id="memeDims">—</b></div>
    </div>

    <div class="field" style="margin-top:14px">
      <label for="memeTop">Top text</label>
      <input class="input" id="memeTop" type="text" placeholder="When the export finally renders" autocomplete="off">
    </div>
    <div class="field">
      <label for="memeBottom">Bottom text</label>
      <input class="input" id="memeBottom" type="text" placeholder="In the first try" autocomplete="off">
    </div>

    <div class="row">
      <div class="field">
        <label for="memeSize">Text size</label>
        <div class="range-row">
          <input type="range" id="memeSize" min="3" max="18" step="0.5" value="9">
          <output id="memeSizeValue">9</output>
        </div>
      </div>
      <div class="field">
        <label for="memeColor">Text colour</label>
        <input type="color" id="memeColor" value="#ffffff">
      </div>
    </div>

    <div class="row">
      <div class="field">
        <span class="field-label">Uppercase</span>
        <div class="seg" id="upperSeg">
          <button type="button" data-upper="1" class="on" aria-pressed="true">On</button>
          <button type="button" data-upper="0" aria-pressed="false">Off</button>
        </div>
        <input type="hidden" id="memeUpper" value="1">
      </div>
      <div class="field">
        <span class="field-label">Outline</span>
        <div class="seg" id="outlineSeg">
          <button type="button" data-outline="1" class="on" aria-pressed="true">On</button>
          <button type="button" data-outline="0" aria-pressed="false">Off</button>
        </div>
        <input type="hidden" id="memeOutline" value="1">
      </div>
    </div>

    <div class="note"><span class="pin">i</span><span>Text size is a percentage of the image width, so the same setting looks the same on a phone photo and a wide screenshot.</span></div>
  </div>

  <div class="pane">
    <div class="pane-head"><h2>Preview</h2><span class="hint" id="memeHint">No image yet</span></div>

    <div class="canvas-box">
      <span class="canvas-empty" id="memeEmpty">Choose an image to start captioning.</span>
      <canvas id="memeCanvas" hidden></canvas>
    </div>

    <div class="split-actions" style="margin-top:14px">
      <button class="btn btn-primary" id="memeDownload" type="button" disabled>Download PNG</button>
      <button class="btn btn-ghost" id="memeReset" type="button">Reset</button>
    </div>

    <div class="note"><span class="pin">i</span><span>The download is the full-resolution image with the same text it shows in the preview.</span></div>
  </div>
</section>

<section class="below">
  <aside class="aside">
    <h2>Next tools</h2>
    <div class="related">
      {% for r in c.related %}{% set rt = toolList | toolBySlug(r.slug) %}
      <a href="{{ rt.url }}"><span class="icon-tile {{ r.tone }}" aria-hidden="true">{{ icon(rt.icon) }}</span><span><b>{{ rt.relatedName or rt.footerName or rt.name }}</b><small>{{ r.note }}</small></span></a>
      {% endfor %}
    </div>
  </aside>
</section>
